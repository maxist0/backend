# Base configuration template
# These values are overridden by .env.{environment} files

# Database
DATABASE_URL=sqlite:///./app.db

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Application
DEBUG=false
APP_NAME=api
APP_DESCRIPTION=API Description
APP_VERSION=0.1.0
