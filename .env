# Base configuration template
# These values are overridden by .env.{environment} files


# Universal -- only change here
APP_NAME=api
APP_DESCRIPTION=API Description
APP_VERSION=0.1.0
LOG_DIR=logs
PORT=8000
HOST=0.0.0.0

JWT_ALGORITHM=HS256
ACCESS_LOG_ENABLED=true
METRICS_ENABLED=true

# Default values - should be overridden by environment-specific .env files
DEBUG=false
LOG_LEVEL=INFO