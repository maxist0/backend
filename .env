# App
ENVIRONMENT=
DEBUG=
APP_NAME=
APP_DESCRIPTION=
APP_VERSION=0.1.0
FRONTEND_URL=

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache (Redis)
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
CACHE_PASSWORD=
CACHE_MAX_CONNECTIONS=10
CACHE_KEY_PREFIX=fastapi-cache

# Taskiq
TASKIQ_BROKER_URL=redis://:redis@localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://:redis@localhost:6379/2
TASKIQ_WORKERS=2
TASKIQ_METRICS_PORT=9000
TASKIQ_RETRY_COUNT=3
TASKIQ_RETRY_DELAY_SECONDS=60

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password hashing
BCRYPT_ROUNDS=12

# Logging & Metrics
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
METRICS_ENABLED=true

# OTLP (OpenTelemetry)
OTLP_LOGS_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318
OTLP_SERVICE_NAME=api
OTLP_HEADERS=

# Mail Server
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=true