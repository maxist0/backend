# App
ENVIRONMENT=
APP_NAME=
APP_DESCRIPTION=
APP_VERSION=0.1.0
API_PREFIX=/api/v1
# Base of the links in emails: http(s)://host[:port][/path], here the
# frontend dev server. Outside dev/unittest it must be https and not this value.
FRONTEND_URL=http://localhost:5173
# Frontend pages the links open (absolute paths, appended to FRONTEND_URL).
FRONTEND_VERIFY_EMAIL_PATH=/user/email-bestaetigen
FRONTEND_RESET_PASSWORD_PATH=/user/passwort-zuruecksetzen
# JSON list of browser origins; '*' is refused (credentials are allowed).
CORS_ORIGINS=["http://localhost:5173"]

# Server
HOST=0.0.0.0
PORT=8000
# Reverse proxy addresses trusted for X-Forwarded-For/-Proto (comma-separated).
FORWARDED_ALLOW_IPS=127.0.0.1

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache (Redis)
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
CACHE_PASSWORD=
CACHE_MAX_CONNECTIONS=10

# Taskiq (db 1: task stream and retry schedules, db 2: results)
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
# Worker processes started by `run.py dev` (1..64; Windows always runs one)
TASKIQ_WORKERS=2
# Prometheus endpoint of the worker: IP or hostname, port 1..65535.
# Loopback by default; containers set 0.0.0.0.
TASKIQ_METRICS_HOST=127.0.0.1
TASKIQ_METRICS_PORT=9000
# Retries after the first run of a task raising TransientTaskError (0..10)
TASKIQ_RETRY_COUNT=3
# Seconds before each retry (30..3600); the scheduler must run
TASKIQ_RETRY_DELAY_SECONDS=60

# JWT Authentication (HS256 is fixed in code)
# Required outside dev/unittest: at least 32 characters, not the code default.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Secrets stay commented here: an unedited copy keeps the dev defaults, not "".
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password hashing (Argon2id; changing the cost re-hashes on next login)
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_HASH_CONCURRENCY=4

# Login lockout: failed password logins before a timed lock, and its length
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Admin panel (/admin). Unset ADMIN_ENABLED means: enabled only in dev.
# When enabled outside dev, ADMIN_PASSWORD and ADMIN_SECRET_KEY must not be
# the code defaults and need at least 32 characters.
# ADMIN_ENABLED=false
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_SECRET_KEY=

# Logging (stdout), metrics and health
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
METRICS_ENABLED=true
READINESS_TIMEOUT_SECONDS=2

# Mail Server (incomplete: the mail task sends nothing, logs email.not_sent)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=true