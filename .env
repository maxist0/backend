# App
ENVIRONMENT=
DEBUG=
APP_NAME=
APP_DESCRIPTION=
APP_VERSION=0.1.0
FRONTEND_URL=

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/api
DB_CONNECT_TIMEOUT=10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Cache (Redis)
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_DB=0
CACHE_PASSWORD=
CACHE_MAX_CONNECTIONS=10
CACHE_KEY_PREFIX=fastapi-cache

# Taskiq
TASKIQ_BROKER_URL=redis://localhost:6379/1
TASKIQ_RESULT_BACKEND_URL=redis://localhost:6379/2
TASKIQ_WORKERS=2
TASKIQ_METRICS_PORT=9000
TASKIQ_RETRY_COUNT=3
TASKIQ_RETRY_DELAY_SECONDS=60

# JWT Authentication (HS256 is fixed in code)
# Required outside dev/unittest: at least 32 characters, not the code default.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Secrets stay commented here: an unedited copy keeps the dev defaults, not "".
# JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Password hashing (Argon2id; changing the cost re-hashes on next login)
ARGON2_TIME_COST=3
ARGON2_MEMORY_KIB=65536
ARGON2_PARALLELISM=4
PASSWORD_HASH_CONCURRENCY=4

# Admin panel (/admin). Unset ADMIN_ENABLED means: enabled only in dev.
# When enabled outside dev, ADMIN_PASSWORD and ADMIN_SECRET_KEY must not be
# the code defaults.
# ADMIN_ENABLED=false
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
# ADMIN_SECRET_KEY=

# Logging & Metrics
LOG_LEVEL=INFO
ACCESS_LOG_ENABLED=true
METRICS_ENABLED=true

# OTLP (OpenTelemetry)
OTLP_LOGS_ENABLED=false
OTLP_ENDPOINT=http://localhost:4318
OTLP_SERVICE_NAME=api
OTLP_HEADERS=

# Mail Server
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_STARTTLS=true