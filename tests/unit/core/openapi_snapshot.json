    "/api/v1/auth/refresh": {
      "post": {
        "description": "Exchange the refresh cookie for a new access token.\n\nThe refresh token is rotated: the cookie is replaced and the old token\nstops working. Presenting a rotated token again revokes all sessions of\nits family. No access token is needed. A refused cookie (unknown,\nexpired, revoked or reused) is cleared with the 401.\n\nAt most 60 refreshes per minute from one client address and 10 per\nminute for one login session; more get 429 with `Retry-After`, and the\ncookie stays valid.",
        "operationId": "refresh_tokens_api_v1_auth_refresh_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized: `invalid_refresh_token`"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests: `rate_limited`"
          }
        },
        "summary": "Get a new access token",
        "tags": [
          "authentication"
        ]
      }
    },
