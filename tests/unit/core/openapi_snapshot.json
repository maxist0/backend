    "/api/v1/auth/email/verify": {
      "post": {
        "description": "Redeem the token of a verification or email-change link.\n\nA verification link marks the address verified. An email-change link\nswitches the account to the new address (409 `email_taken` if another\naccount took it meanwhile). Each token works once. At most 10 attempts\nper 15 minutes from one client address; more get 429 with `Retry-After`.",
        "operationId": "email_verify_api_v1_auth_email_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Bad Request: `invalid_token`"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Conflict: `email_taken`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Content: `validation_error`"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests: `rate_limited`"
          }
        },
        "summary": "Confirm an email address",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/email/verify/resend": {
      "post": {
        "description": "Send a new verification link to the signed-in user's address.\n\nEarlier links stop working. At most 3 requests per hour per user and 3\nper hour to one address; more get 429 with `Retry-After`.",
        "operationId": "email_verify_resend_api_v1_auth_email_verify_resend_post",
        "responses": {
          "202": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Bad Request: `email_already_verified`"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized: `unauthorized`"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests: `rate_limited`"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Resend the verification email",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Sign in with the OAuth2 password form (`username`, `password`).\n\nReturns an access token and the user. The refresh token is set as an\nhttpOnly cookie for the auth routes. A wrong password, an unknown user and\na locked or deactivated account all get the same 401.\n\nAt most 20 attempts per minute from one client address (an IPv6 client\nper /64, and 100 per minute per /48), and 10 per 15 minutes for one\nusername from one address, whether the account exists or not; more get\n429 with `Retry-After`.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_api_v1_auth_login_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized: `invalid_credentials`"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Content: `validation_error`"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests: `rate_limited`"
          }
        },
        "summary": "Sign in",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revoke the session of the refresh cookie and clear the cookie.\n\nNo access token is needed. A refresh token that was already rotated is\ntreated like reuse on refresh: all sessions of its family are revoked,\nthe answer is 401 and the cookie is cleared.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Bad Request: `session_not_found`"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized: `invalid_refresh_token`"
          }
        },
        "summary": "Sign out this session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "description": "Revoke every session of the signed-in user and clear the refresh cookie.\n\nAccess tokens already issued stay valid until they expire\n(`ACCESS_TOKEN_EXPIRE_MINUTES`).",
        "operationId": "logout_all_api_v1_auth_logout_all_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unauthorized: `unauthorized`"
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "summary": "Sign out on all devices",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/password/forgot": {
      "post": {
        "description": "Send a password-reset link if the address belongs to an account.\n\nThe answer is the same whether or not it does. At most 5 requests per\n15 minutes from one client address (an IPv6 client per /64, and 25 per\n/48) and 3 per hour for one email address, whether it belongs to an\naccount or not; more get 429 with `Retry-After`.",
        "operationId": "password_forgot_api_v1_auth_password_forgot_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordForgotRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Unprocessable Content: `validation_error`"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Too Many Requests: `rate_limited`"
          }
        },
        "summary": "Request a password-reset email",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/password/reset": {
      "post": {
        "description": "Set a new password with the token from the reset email.\n\nEvery session of the account is signed out. At most 10 attempts per 15\nminutes from one client address; more get 429 with `Retry-After`.",
        "operationId": "password_reset_api_v1_auth_password_reset_post",
        "requestBody": {
          "content": {
